%>

<div class="content-wrapper">
    <h1 class="box-title"><a href=<%= lien + "?but=annexe/sous-categorie/sous-categorie-liste.jsp"%> <i class="fa fa-arrow-circle-left"></i></a><%=pc.getTitre()%></h1>
    <div class="row">
        <div class="col-md-12">
            <div class="box-fiche">
                <div class="box">
